#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "../protos/RobotLimpiadorCienaga.proto"

WorldInfo {
  info [
    "Robot Autonomo Limpiador de Basura - Plaza del Centenario (Cienaga, Magdalena)"
    "Simulacion con traccion diferencial de 4 ruedas, brazo de 4 DOF y camara superior."
    "Entorno: Plaza del Centenario, El Templete neoclasico, Iglesia colonial San Juan Bautista y Sierra Nevada."
  ]
  title "Plaza del Centenario - Robot Limpiador Cienaga"
  basicTimeStep 16
  coordinateSystem "ENU"
  defaultDamping Damping {
    linear 0.2
    angular 0.4
  }
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction [
        1.2
      ]
      bounce 0.1
      softCFM 0.0001
      softERP 0.6
    }
  ]
}

Viewpoint {
  orientation 0.28 0.25 0.93 2.15
  position -4.5 0 14.5
  near 0.1
  far 500
  follow "Robot_Limpiador_Cienaga"
  followType "Tracking Shot"
}

TexturedBackground {}
TexturedBackgroundLight {}

DirectionalLight {
  ambientIntensity 0.35
  direction 0.65 0.35 -0.68
  intensity 1.6
  castShadows TRUE
}

# -------------------------------------------------------------
# SUELO FISICO DE LA PLAZA DEL CENTENARIO Y COLISIONES
# -------------------------------------------------------------
Solid {
  name "suelo_plaza_principal"
  translation 20 0 -0.04
  boundingObject Box {
    size 56 46 0.08
  }
  contactMaterial "default"
}

# Base física del Templete central
Solid {
  name "templete_colision_base"
  translation 16 0 0.30
  boundingObject Cylinder {
    height 0.60
    radius 4.2
  }
  contactMaterial "default"
}

# Muros físicos de la Iglesia San Juan Bautista
Solid {
  name "iglesia_colision_muro"
  translation 51 3 5.0
  boundingObject Box {
    size 28 14 10
  }
  contactMaterial "default"
}

# Torre campanario colisión
Solid {
  name "iglesia_torre_colision"
  translation 39.2 -4.2 12.0
  boundingObject Box {
    size 6 6 24
  }
  contactMaterial "default"
}

# Muros perimetrales invisibles para seguridad del robot
Solid {
  name "limite_plaza_norte"
  translation 20 22 1.5
  boundingObject Box {
    size 56 1.0 3.0
  }
}
Solid {
  name "limite_plaza_sur"
  translation 20 -22 1.5
  boundingObject Box {
    size 56 1.0 3.0
  }
}
Solid {
  name "limite_plaza_oeste"
  translation -8 0 1.5
  boundingObject Box {
    size 1.0 46 3.0
  }
}

